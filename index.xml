    <reapack name="jiachen_Ear Training Question Generator.lua" type="script" desc="Ear Training Question Generator">
      <metadata>
        <description><![CDATA[{\rtf1\ansi\deff0{\fonttbl{\f0 \fswiss Helvetica;}{\f1 \fmodern Courier;}}
{\colortbl;\red255\green0\blue0;\red0\green0\blue255;}
\widowctrl\hyphauto

{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel0 \b \fs36 Ear Training Question Generator\par}
{\pard \ql \f0 \sa180 \li0 \fi0 This script provides functionality for generating ear training exercises in Reaper. It can generate various types of ear training exercises, including:\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Scale degree recognition\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Chord progression recognition\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Interval recognition\sa180\par}
{\pard \ql \f0 \sa180 \li0 \fi0 The script supports exporting exercise data to CSV files for reference.\par}
}
]]></description>
